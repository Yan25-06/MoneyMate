<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav_auth"
    app:startDestination="@id/loginFragment">

    <!-- ══════════════════════════════════════════════════════════════════════
         LOGIN
         ══════════════════════════════════════════════════════════════════════ -->
    <fragment
        android:id="@+id/loginFragment"
        android:name="com.group10.moneymate.ui.auth.LoginFragment"
        android:label="@string/btn_login"
        tools:layout="@layout/fragment_login">

        <!-- Login → Register -->
        <action
            android:id="@+id/action_login_to_register"
            app:destination="@id/registerFragment"
            app:enterAnim="@anim/slide_in_right"
            app:exitAnim="@anim/slide_out_left"
            app:popEnterAnim="@anim/slide_in_left"
            app:popExitAnim="@anim/slide_out_right" />

        <!-- Login → Forgot Password -->
        <action
            android:id="@+id/action_login_to_forgot_password"
            app:destination="@id/forgotPasswordFragment"
            app:enterAnim="@anim/slide_in_right"
            app:exitAnim="@anim/slide_out_left"
            app:popEnterAnim="@anim/slide_in_left"
            app:popExitAnim="@anim/slide_out_right" />

        <!-- Login → Passcode (VERIFY mode) — hiện khi passcode đã thiết lập -->
        <action
            android:id="@+id/action_login_to_passcode"
            app:destination="@id/passcodeFragment"
            app:enterAnim="@anim/slide_in_up"
            app:exitAnim="@anim/slide_out_down"
            app:popEnterAnim="@anim/slide_in_up"
            app:popExitAnim="@anim/slide_out_down" />

    </fragment>

    <!-- ══════════════════════════════════════════════════════════════════════
         REGISTER
         ══════════════════════════════════════════════════════════════════════ -->
    <fragment
        android:id="@+id/registerFragment"
        android:name="com.group10.moneymate.ui.auth.RegisterFragment"
        android:label="@string/title_register"
        tools:layout="@layout/fragment_register">

        <!-- Register → Back to Login -->
        <action
            android:id="@+id/action_register_back_to_login"
            app:destination="@id/loginFragment"
            app:popUpTo="@id/loginFragment"
            app:popUpToInclusive="true"
            app:enterAnim="@anim/slide_in_left"
            app:exitAnim="@anim/slide_out_right"
            app:popEnterAnim="@anim/slide_in_right"
            app:popExitAnim="@anim/slide_out_left" />

        <!-- Register → Passcode (CREATE mode) — bắt buộc sau khi đăng ký -->
        <action
            android:id="@+id/action_register_to_passcode"
            app:destination="@id/passcodeFragment"
            app:popUpTo="@id/loginFragment"
            app:popUpToInclusive="true"
            app:enterAnim="@anim/slide_in_right"
            app:exitAnim="@anim/slide_out_left"
            app:popEnterAnim="@anim/slide_in_left"
            app:popExitAnim="@anim/slide_out_right" />

    </fragment>

    <!-- ══════════════════════════════════════════════════════════════════════
         FORGOT PASSWORD
         ══════════════════════════════════════════════════════════════════════ -->
    <fragment
        android:id="@+id/forgotPasswordFragment"
        android:name="com.group10.moneymate.ui.auth.ForgotPasswordFragment"
        android:label="@string/forgot_password"
        tools:layout="@layout/fragment_forgot_password">

        <!-- Forgot Password → Back to Login -->
        <action
            android:id="@+id/action_forgotPassword_back_to_login"
            app:destination="@id/loginFragment"
            app:popUpTo="@id/loginFragment"
            app:popUpToInclusive="true"
            app:enterAnim="@anim/slide_in_left"
            app:exitAnim="@anim/slide_out_right"
            app:popEnterAnim="@anim/slide_in_right"
            app:popExitAnim="@anim/slide_out_left" />

    </fragment>

    <!-- ══════════════════════════════════════════════════════════════════════
         PASSCODE (CREATE mode mặc định — fragment tự đọc args để biết mode)
         ══════════════════════════════════════════════════════════════════════ -->
    <fragment
        android:id="@+id/passcodeFragment"
        android:name="com.group10.moneymate.ui.security.PasscodeFragment"
        android:label="@string/title_passcode"
        tools:layout="@layout/fragment_passcode">

        <argument
            android:name="passcode_mode"
            app:argType="integer"
            android:defaultValue="0" />

        <argument
            android:name="passcode_finish_to_home"
            app:argType="boolean"
            android:defaultValue="true" />

        <!-- Passcode CREATE → Passcode CONFIRM (self-loop với args khác) -->
        <action
            android:id="@+id/action_passcode_to_confirm"
            app:destination="@id/passcodeFragment"
            app:enterAnim="@anim/slide_in_right"
            app:exitAnim="@anim/slide_out_left"
            app:popEnterAnim="@anim/slide_in_left"
            app:popExitAnim="@anim/slide_out_right" />

    </fragment>

</navigation>