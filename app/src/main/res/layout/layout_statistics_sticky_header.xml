<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/statistics_header_background"
    android:orientation="vertical"
    android:paddingStart="12dp"
    android:paddingTop="12dp"
    android:paddingEnd="12dp"
    android:paddingBottom="8dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageButton
            android:id="@+id/btnHeaderBack"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/bg_statistics_header_icon_button"
            android:contentDescription="@string/common_back"
            android:padding="8dp"
            android:src="@drawable/outline_arrow_back_24"
            android:tint="@android:color/white" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnWalletSelector"
            style="@style/Widget.Material3.Button.TonalButton"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="12dp"
            android:layout_weight="1"
            android:ellipsize="end"
            android:gravity="center_vertical"
            android:insetBottom="0dp"
            android:insetTop="0dp"
            android:maxLines="1"
            android:paddingStart="12dp"
            android:paddingEnd="10dp"
            android:text="@string/statistics_wallet_selector_all"
            android:textAllCaps="false"
            android:textColor="@android:color/white"
            android:textSize="16sp"
            app:backgroundTint="@color/statistics_chip_background"
            app:cornerRadius="22dp"
            app:icon="@drawable/outline_account_balance_wallet_24"
            app:iconGravity="textStart"
            app:iconPadding="8dp"
            app:iconTint="@color/statistics_wallet_icon"
            app:rippleColor="@color/statistics_chip_ripple"
            tools:text="Tổng cộng" />

        <ImageButton
            android:id="@+id/btnDateFilter"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/bg_statistics_header_icon_button"
            android:contentDescription="@string/date"
            android:padding="8dp"
            android:src="@drawable/outline_calendar_today_24"
            android:tint="@android:color/white" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp"
        android:gravity="center_horizontal"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvHeaderSummaryLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/total_balance"
            android:textColor="@color/statistics_text_muted"
            android:textSize="15sp"
            tools:text="Số dư" />

        <TextView
            android:id="@+id/tvHeaderTotalAmount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/default_currency_zero"
            android:textColor="@android:color/white"
            android:textSize="34sp"
            android:textStyle="bold"
            tools:text="8,917,000 đ" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageButton
            android:id="@+id/btnPreviousPeriod"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/bg_statistics_header_icon_button"
            android:contentDescription="@string/statistics_previous_period"
            android:padding="8dp"
            android:src="@drawable/outline_arrow_back_24"
            android:tint="@android:color/white" />

        <HorizontalScrollView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:overScrollMode="never"
            android:scrollbars="none">

            <LinearLayout
                android:id="@+id/layoutPeriodTabs"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tvPeriodPrevious"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="8dp"
                    android:background="@drawable/bg_statistics_period_nav_item"
                    android:paddingStart="14dp"
                    android:paddingTop="10dp"
                    android:paddingEnd="14dp"
                    android:paddingBottom="10dp"
                    android:text="@string/statistics_period_previous"
                    android:textColor="@color/statistics_text_muted"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    tools:text="12/2025" />

                <TextView
                    android:id="@+id/tvPeriodCurrent"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="8dp"
                    android:background="@drawable/bg_statistics_period_nav_item_selected"
                    android:paddingStart="14dp"
                    android:paddingTop="10dp"
                    android:paddingEnd="14dp"
                    android:paddingBottom="10dp"
                    android:text="@string/statistics_period_current"
                    android:textColor="@android:color/white"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    tools:text="THÁNG NÀY" />

                <TextView
                    android:id="@+id/tvPeriodNext"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_statistics_period_nav_item"
                    android:paddingStart="14dp"
                    android:paddingTop="10dp"
                    android:paddingEnd="14dp"
                    android:paddingBottom="10dp"
                    android:text="@string/statistics_period_next"
                    android:textColor="@color/statistics_text_muted"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    tools:text="THÁNG TRƯỚC" />
            </LinearLayout>
        </HorizontalScrollView>

        <ImageButton
            android:id="@+id/btnNextPeriod"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/bg_statistics_header_icon_button"
            android:contentDescription="@string/statistics_next_period"
            android:padding="8dp"
            android:rotation="180"
            android:src="@drawable/outline_arrow_back_24"
            android:tint="@android:color/white" />
    </LinearLayout>

</LinearLayout>
