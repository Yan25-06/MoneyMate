<?xml version="1.0" encoding="utf-8"?>
<!--
    Item ví trong RecyclerView — nằm bên trong card colorSurfaceContainerHigh (cv_wallets).
    Không dùng card riêng mỗi item → giữ flat look, ripple trên root.
-->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:padding="16dp"
    android:background="?attr/selectableItemBackground"
    android:clickable="true"
    android:focusable="true">

    <!-- Icon loại ví trong vòng tròn màu — đồng bộ với icon style trong fragment_home -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cv_icon"
        android:layout_width="44dp"
        android:layout_height="44dp"
        app:cardCornerRadius="16dp"
        app:cardBackgroundColor="#EEF4FF"
        app:cardElevation="0dp"
        app:strokeWidth="0dp">

        <ImageView
            android:id="@+id/iv_icon"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_gravity="center"
            android:contentDescription="@string/wallet"
            tools:src="@drawable/outline_account_balance_wallet_24" />

    </com.google.android.material.card.MaterialCardView>

    <!-- Tên ví + loại ví -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:layout_marginStart="16dp">

        <TextView
            android:id="@+id/tv_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/statistics_text_primary"
            android:textSize="16sp"
            android:textStyle="bold"
            tools:text="Tiền mặt" />

        <TextView
            android:id="@+id/tv_type"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textColor="@color/statistics_text_secondary"
            android:textSize="13sp"
            tools:text="Tiền mặt" />

        <TextView
            android:id="@+id/tv_archived_badge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:background="@drawable/bg_wallet_archived_badge"
            android:paddingStart="8dp"
            android:paddingTop="3dp"
            android:paddingEnd="8dp"
            android:paddingBottom="3dp"
            android:text="@string/wallet_archived_badge"
            android:textColor="@color/statistics_text_secondary"
            android:textSize="11sp"
            android:textStyle="bold"
            android:visibility="gone"
            tools:visibility="visible" />

    </LinearLayout>

    <!-- Số dư -->
    <TextView
        android:id="@+id/tv_balance"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="8dp"
        android:textColor="@color/statistics_text_primary"
        android:textSize="16sp"
        android:textStyle="bold"
        tools:text="10.000.000 ₫" />

    <!-- Menu button -->
    <ImageButton
        android:id="@+id/btn_menu"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/wallet_options"
        android:src="@drawable/outline_more_horiz_24"
        app:tint="@color/statistics_text_muted" />

</LinearLayout>
