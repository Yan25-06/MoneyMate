<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@android:color/white"
    android:clickable="true"
    android:focusable="true"
    android:orientation="vertical"
    android:paddingStart="16dp"
    android:paddingTop="16dp"
    android:paddingEnd="16dp"
    android:paddingBottom="10dp"
    android:foreground="?attr/selectableItemBackground">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <FrameLayout
            android:id="@+id/iconContainer"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="@drawable/bg_circle_icon"
            android:backgroundTint="@color/budget_screen_divider">

            <ImageView
                android:id="@+id/iv_icon"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_gravity="center"
                android:contentDescription="@string/category"
                android:src="@drawable/outline_account_balance_wallet_24"
                android:tint="@color/budget_safe_green" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tv_category"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@color/budget_text_primary"
                android:textSize="18sp"
                android:textStyle="bold"
                tools:text="Bills &amp; Utilities" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="12dp"
                    android:layout_height="12dp"
                    android:contentDescription="@string/wallet"
                    android:src="@drawable/outline_account_balance_wallet_24"
                    android:tint="@color/budget_text_secondary" />

                <TextView
                    android:id="@+id/tv_wallet_scope"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textColor="@color/budget_text_secondary"
                    android:textSize="12sp"
                    tools:text="Ví gia đình" />

                <View
                    android:layout_width="4dp"
                    android:layout_height="4dp"
                    android:layout_marginStart="8dp"
                    android:layout_marginEnd="8dp"
                    android:background="@drawable/bg_circle_icon"
                    android:backgroundTint="@color/budget_muted_gray" />

                <ImageView
                    android:layout_width="12dp"
                    android:layout_height="12dp"
                    android:contentDescription="@string/date"
                    android:src="@drawable/outline_calendar_today_24"
                    android:tint="@color/budget_text_secondary" />

                <TextView
                    android:id="@+id/tv_period"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textColor="@color/budget_text_secondary"
                    android:textSize="12sp"
                    tools:text="01/03 - 31/03" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="end"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tv_amount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/budget_text_primary"
                android:textSize="17sp"
                android:textStyle="bold"
                tools:text="4.000.000" />

            <TextView
                android:id="@+id/tv_remaining"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:textColor="@color/budget_text_secondary"
                android:textSize="13sp"
                tools:text="Left 500,000" />
        </LinearLayout>
    </LinearLayout>

    <FrameLayout
        android:id="@+id/progressMarkerContainer"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginStart="62dp"
        android:layout_marginTop="12dp">

        <com.google.android.material.progressindicator.LinearProgressIndicator
            android:id="@+id/progress_budget"
            android:layout_width="match_parent"
            android:layout_height="8dp"
            android:layout_gravity="top"
            app:indicatorColor="@color/budget_safe_green"
            app:trackColor="@color/budget_track_gray"
            app:trackCornerRadius="4dp"
            app:trackThickness="8dp" />

        <View
            android:id="@+id/v_today_marker"
            android:layout_width="2dp"
            android:layout_height="14dp"
            android:layout_marginTop="0dp"
            android:background="@color/budget_marker_gray" />

        <TextView
            android:id="@+id/tv_today"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_budget_today_chip"
            android:paddingStart="10dp"
            android:paddingTop="4dp"
            android:paddingEnd="10dp"
            android:paddingBottom="4dp"
            android:text="@string/budget_today"
            android:textColor="@color/budget_text_secondary"
            android:textSize="11sp"
            android:textStyle="bold" />
    </FrameLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="10dp"
        android:background="@color/budget_divider" />

</LinearLayout>
