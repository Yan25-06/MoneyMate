<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white">

    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/top_app_bar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:background="@color/white"
            android:title="@string/add_wallet"
            android:titleTextColor="@color/budget_text_primary"
            app:navigationContentDescription="@string/common_cancel"
            app:navigationIcon="@drawable/outline_close_24"
            app:navigationIconTint="@color/budget_text_primary" />

    </com.google.android.material.appbar.AppBarLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:padding="16dp"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Input tên ví -->
            <com.google.android.material.textfield.TextInputLayout
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/hint_wallet_name"
                app:counterEnabled="true"
                app:counterMaxLength="25"
                app:boxStrokeColor="@color/color_accent"
                app:hintTextColor="@color/budget_text_secondary">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/et_name"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="textCapWords"
                    android:maxLength="25"
                    android:textColor="@color/budget_text_primary" />

            </com.google.android.material.textfield.TextInputLayout>

            <!-- Dropdown loại ví -->
            <com.google.android.material.textfield.TextInputLayout
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:hint="@string/wallet_type"
                app:boxStrokeColor="@color/color_accent"
                app:hintTextColor="@color/budget_text_secondary">

                <AutoCompleteTextView
                    android:id="@+id/dropdown_type"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="none"
                    android:hint="@string/wallet_type"
                    android:textColor="@color/budget_text_primary" />

            </com.google.android.material.textfield.TextInputLayout>

            <!-- Input số dư -->
            <com.google.android.material.textfield.TextInputLayout
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:hint="@string/hint_initial_balance"
                app:boxStrokeColor="@color/color_accent"
                app:hintTextColor="@color/budget_text_secondary">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/et_balance"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:digits="0123456789"
                    android:inputType="number"
                    android:textColor="@color/budget_text_primary" />

            </com.google.android.material.textfield.TextInputLayout>

            <!-- Nút lưu — green accent -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_save"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="@string/btn_save"
                android:textColor="@color/white"
                app:backgroundTint="@color/color_accent"
                app:cornerRadius="12dp" />

        </LinearLayout>

    </ScrollView>

</androidx.coordinatorlayout.widget.CoordinatorLayout>