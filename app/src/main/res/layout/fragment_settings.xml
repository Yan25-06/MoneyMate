<?xml version="1.0" encoding="utf-8"?>
<!--
  fragment_settings.xml — Phase 4 UI
  Thêm card "Đồng bộ dữ liệu" giữa section_data và section_display.
  Giữ nguyên toàn bộ nội dung cũ, chỉ thêm phần được đánh dấu THÊM MỚI.
-->
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/statistics_surface">

    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/app_bar_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/statistics_surface">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/tb_settings"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:background="@android:color/transparent"
            android:minHeight="56dp"
            app:navigationIcon="@null"
            app:title="@string/title_settings"
            app:titleCentered="false"
            app:titleTextAppearance="@style/TextAppearance.Material3.TitleLarge.Emphasized" />

    </com.google.android.material.appbar.AppBarLayout>

    <androidx.core.widget.NestedScrollView
        android:id="@+id/scroll_settings"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:fillViewport="true"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="18dp"
            android:paddingTop="12dp"
            android:paddingEnd="18dp"
            android:paddingBottom="112dp">

            <!-- ── Tài khoản ─────────────────────────────────────────────────── -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                android:text="@string/section_account"
                android:textColor="@color/statistics_text_secondary"
                android:textSize="13sp"
                android:textStyle="bold" />

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                app:cardBackgroundColor="@color/white"
                app:cardCornerRadius="24dp"
                app:cardElevation="0dp"
                app:strokeColor="@color/statistics_card_stroke"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <LinearLayout
                        android:id="@+id/btn_profile"
                        android:layout_width="match_parent"
                        android:layout_height="68dp"
                        android:background="?attr/selectableItemBackground"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingStart="18dp"
                        android:paddingEnd="18dp">

                        <com.google.android.material.card.MaterialCardView
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            app:cardBackgroundColor="#EEF4FF"
                            app:cardCornerRadius="14dp"
                            app:cardElevation="0dp">
                            <ImageView
                                android:layout_width="20dp"
                                android:layout_height="20dp"
                                android:layout_gravity="center"
                                android:contentDescription="@null"
                                android:src="@drawable/outline_person_24"
                                app:tint="@color/transfer_blue" />
                        </com.google.android.material.card.MaterialCardView>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="14dp"
                            android:layout_weight="1"
                            android:orientation="vertical">
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/profile"
                                android:textColor="@color/statistics_text_primary"
                                android:textSize="16sp"
                                android:textStyle="bold" />
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:text="@string/settings_profile_hint"
                                android:textColor="@color/statistics_text_secondary"
                                android:textSize="13sp" />
                        </LinearLayout>

                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:contentDescription="@null"
                            android:rotation="180"
                            android:src="@drawable/outline_arrow_back_24"
                            app:tint="@color/statistics_text_muted" />
                    </LinearLayout>

                    <com.google.android.material.divider.MaterialDivider
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginHorizontal="18dp" />

                    <LinearLayout
                        android:id="@+id/btn_security"
                        android:layout_width="match_parent"
                        android:layout_height="68dp"
                        android:background="?attr/selectableItemBackground"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingStart="18dp"
                        android:paddingEnd="18dp">

                        <com.google.android.material.card.MaterialCardView
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            app:cardBackgroundColor="#FFF4E8"
                            app:cardCornerRadius="14dp"
                            app:cardElevation="0dp">
                            <ImageView
                                android:layout_width="20dp"
                                android:layout_height="20dp"
                                android:layout_gravity="center"
                                android:contentDescription="@null"
                                android:src="@drawable/outline_credit_card_24"
                                app:tint="#F79009" />
                        </com.google.android.material.card.MaterialCardView>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="14dp"
                            android:layout_weight="1"
                            android:orientation="vertical">
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/title_passcode"
                                android:textColor="@color/statistics_text_primary"
                                android:textSize="16sp"
                                android:textStyle="bold" />
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:text="@string/settings_security_hint"
                                android:textColor="@color/statistics_text_secondary"
                                android:textSize="13sp" />
                        </LinearLayout>

                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:contentDescription="@null"
                            android:rotation="180"
                            android:src="@drawable/outline_arrow_back_24"
                            app:tint="@color/statistics_text_muted" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- ── Quản lý dữ liệu ──────────────────────────────────────────── -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                android:text="@string/section_data"
                android:textColor="@color/statistics_text_secondary"
                android:textSize="13sp"
                android:textStyle="bold" />

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                app:cardBackgroundColor="@color/white"
                app:cardCornerRadius="24dp"
                app:cardElevation="0dp"
                app:strokeColor="@color/statistics_card_stroke"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <!-- Wallets, Categories, Budgets, Debts, Events — giữ nguyên -->
                    <LinearLayout
                        android:id="@+id/btn_wallets"
                        android:layout_width="match_parent"
                        android:layout_height="64dp"
                        android:background="?attr/selectableItemBackground"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingStart="18dp"
                        android:paddingEnd="18dp">
                        <ImageView android:layout_width="22dp" android:layout_height="22dp" android:contentDescription="@null" android:src="@drawable/outline_account_balance_wallet_24" app:tint="@color/statistics_text_secondary" />
                        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="16dp" android:layout_weight="1" android:text="@string/wallets" android:textColor="@color/statistics_text_primary" android:textSize="16sp" android:textStyle="bold" />
                        <ImageView android:layout_width="18dp" android:layout_height="18dp" android:contentDescription="@null" android:rotation="180" android:src="@drawable/outline_arrow_back_24" app:tint="@color/statistics_text_muted" />
                    </LinearLayout>

                    <com.google.android.material.divider.MaterialDivider android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginHorizontal="18dp" />

                    <LinearLayout
                        android:id="@+id/btn_categories"
                        android:layout_width="match_parent"
                        android:layout_height="64dp"
                        android:background="?attr/selectableItemBackground"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingStart="18dp"
                        android:paddingEnd="18dp">
                        <ImageView android:layout_width="22dp" android:layout_height="22dp" android:contentDescription="@null" android:src="@drawable/outline_payments_24" app:tint="@color/statistics_text_secondary" />
                        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="16dp" android:layout_weight="1" android:text="@string/settings_groups_label" android:textColor="@color/statistics_text_primary" android:textSize="16sp" android:textStyle="bold" />
                        <ImageView android:layout_width="18dp" android:layout_height="18dp" android:contentDescription="@null" android:rotation="180" android:src="@drawable/outline_arrow_back_24" app:tint="@color/statistics_text_muted" />
                    </LinearLayout>

                    <com.google.android.material.divider.MaterialDivider android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginHorizontal="18dp" />

                    <LinearLayout
                        android:id="@+id/btn_budgets"
                        android:layout_width="match_parent"
                        android:layout_height="64dp"
                        android:background="?attr/selectableItemBackground"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingStart="18dp"
                        android:paddingEnd="18dp">
                        <ImageView android:layout_width="22dp" android:layout_height="22dp" android:contentDescription="@null" android:src="@drawable/outline_bar_chart_24" app:tint="@color/statistics_text_secondary" />
                        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="16dp" android:layout_weight="1" android:text="@string/statistics" android:textColor="@color/statistics_text_primary" android:textSize="16sp" android:textStyle="bold" />
                        <ImageView android:layout_width="18dp" android:layout_height="18dp" android:contentDescription="@null" android:rotation="180" android:src="@drawable/outline_arrow_back_24" app:tint="@color/statistics_text_muted" />
                    </LinearLayout>

                    <com.google.android.material.divider.MaterialDivider android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginHorizontal="18dp" />

                    <LinearLayout
                        android:id="@+id/btn_debts"
                        android:layout_width="match_parent"
                        android:layout_height="64dp"
                        android:background="?attr/selectableItemBackground"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingStart="18dp"
                        android:paddingEnd="18dp">
                        <ImageView android:layout_width="22dp" android:layout_height="22dp" android:contentDescription="@null" android:src="@drawable/outline_receipt_24" app:tint="@color/statistics_text_secondary" />
                        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="16dp" android:layout_weight="1" android:text="@string/debts" android:textColor="@color/statistics_text_primary" android:textSize="16sp" android:textStyle="bold" />
                        <ImageView android:layout_width="18dp" android:layout_height="18dp" android:contentDescription="@null" android:rotation="180" android:src="@drawable/outline_arrow_back_24" app:tint="@color/statistics_text_muted" />
                    </LinearLayout>

                    <com.google.android.material.divider.MaterialDivider android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginHorizontal="18dp" />

                    <LinearLayout
                        android:id="@+id/btn_events"
                        android:layout_width="match_parent"
                        android:layout_height="64dp"
                        android:background="?attr/selectableItemBackground"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingStart="18dp"
                        android:paddingEnd="18dp">
                        <ImageView android:layout_width="22dp" android:layout_height="22dp" android:contentDescription="@null" android:src="@drawable/outline_account_balance_24" app:tint="@color/statistics_text_secondary" />
                        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="16dp" android:layout_weight="1" android:text="@string/events" android:textColor="@color/statistics_text_primary" android:textSize="16sp" android:textStyle="bold" />
                        <ImageView android:layout_width="18dp" android:layout_height="18dp" android:contentDescription="@null" android:rotation="180" android:src="@drawable/outline_arrow_back_24" app:tint="@color/statistics_text_muted" />
                    </LinearLayout>

                    <com.google.android.material.divider.MaterialDivider android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginHorizontal="18dp" />

                    <!-- Thông báo -->
                    <LinearLayout
                        android:id="@+id/btn_notifications"
                        android:layout_width="match_parent"
                        android:layout_height="64dp"
                        android:background="?attr/selectableItemBackground"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingStart="18dp"
                        android:paddingEnd="18dp">
                        <ImageView android:layout_width="22dp" android:layout_height="22dp" android:contentDescription="@null" android:src="@drawable/outline_notifications_24" app:tint="@color/statistics_text_secondary" />
                        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="16dp" android:layout_weight="1" android:text="@string/notif_settings_title" android:textColor="@color/statistics_text_primary" android:textSize="16sp" android:textStyle="bold" />
                        <ImageView android:layout_width="18dp" android:layout_height="18dp" android:contentDescription="@null" android:rotation="180" android:src="@drawable/outline_arrow_back_24" app:tint="@color/statistics_text_muted" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>


            <!-- ══════════════════════════════════════════════════════════════ -->
            <!-- THÊM MỚI: Card đồng bộ dữ liệu                              -->
            <!-- ══════════════════════════════════════════════════════════════ -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                android:text="@string/section_sync"
                android:textColor="@color/statistics_text_secondary"
                android:textSize="13sp"
                android:textStyle="bold" />

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                app:cardBackgroundColor="@color/white"
                app:cardCornerRadius="24dp"
                app:cardElevation="0dp"
                app:strokeColor="@color/statistics_card_stroke"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="18dp">

                    <!-- Trạng thái và nút sync -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <com.google.android.material.card.MaterialCardView
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            app:cardBackgroundColor="#EDF7F0"
                            app:cardCornerRadius="14dp"
                            app:cardElevation="0dp">

                            <!-- Icon đám mây khi IDLE/SUCCESS -->
                            <ImageView
                                android:id="@+id/iv_sync_icon"
                                android:layout_width="20dp"
                                android:layout_height="20dp"
                                android:layout_gravity="center"
                                android:contentDescription="@null"
                                android:src="@drawable/outline_history_24"
                                app:tint="@color/income_green" />

                            <!-- Spinner khi SYNCING -->
                            <ProgressBar
                                android:id="@+id/pb_sync_spinner"
                                android:layout_width="20dp"
                                android:layout_height="20dp"
                                android:layout_gravity="center"
                                android:indeterminateTint="@color/income_green"
                                android:visibility="gone" />
                        </com.google.android.material.card.MaterialCardView>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="14dp"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/sync_cloud_title"
                                android:textColor="@color/statistics_text_primary"
                                android:textSize="16sp"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/tv_sync_status"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:textColor="@color/statistics_text_secondary"
                                android:textSize="13sp"
                                tools:text="Đồng bộ lần cuối: 14:32" />
                        </LinearLayout>

                        <!-- Badge trạng thái: SUCCESS=xanh, FAILED=đỏ, SYNCING=ẩn -->
                        <com.google.android.material.chip.Chip
                            android:id="@+id/chip_sync_state"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:checkable="false"
                            android:clickable="false"
                            android:focusable="false"
                            android:textSize="12sp"
                            app:chipCornerRadius="8dp"
                            app:chipMinHeight="28dp"
                            tools:text="Đã đồng bộ" />
                    </LinearLayout>

                    <!-- Thanh tiến trình (chỉ hiện khi SYNCING) -->
                    <com.google.android.material.progressindicator.LinearProgressIndicator
                        android:id="@+id/progress_sync"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:indeterminate="true"
                        android:visibility="gone"
                        app:indicatorColor="@color/income_green"
                        app:trackColor="@color/statistics_card_stroke" />

                    <!-- Nút đồng bộ ngay -->
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_sync_now"
                        style="@style/Widget.Material3.Button.OutlinedButton"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:layout_marginTop="14dp"
                        android:text="@string/sync_now_button"
                        android:textAllCaps="false"
                        app:icon="@drawable/outline_history_24"
                        app:iconGravity="textStart" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
            <!-- ══════════════════════════════════════════════════════════════ -->


            <!-- ── Đăng xuất ─────────────────────────────────────────────────── -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                app:cardBackgroundColor="#FFF4F4"
                app:cardCornerRadius="24dp"
                app:cardElevation="0dp"
                app:strokeColor="#FECACA"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="18dp">

                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/settings_logout_title" android:textColor="@color/statistics_text_primary" android:textSize="17sp" android:textStyle="bold" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:text="@string/settings_logout_hint" android:textColor="@color/statistics_text_secondary" android:textSize="14sp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_logout"
                        style="@style/Widget.Material3.Button.TonalButton"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:text="@string/btn_logout"
                        android:textColor="@color/expense_red"
                        app:backgroundTint="#FEE2E2"
                        app:icon="@drawable/outline_close_24"
                        app:iconTint="@color/expense_red" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <TextView
                android:id="@+id/tv_version"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="20dp"
                android:textColor="@color/statistics_text_muted"
                android:textSize="12sp"
                tools:text="MoneyMate 1.0.0" />

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</androidx.coordinatorlayout.widget.CoordinatorLayout>