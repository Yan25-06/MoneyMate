<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/transaction_surface"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="20dp"
        android:paddingTop="16dp"
        android:paddingEnd="20dp"
        android:paddingBottom="14dp">

        <ImageButton
            android:id="@+id/btn_confirmation_back"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/bg_statistics_header_icon_button"
            android:contentDescription="@string/common_back"
            android:padding="8dp"
            android:src="@drawable/outline_arrow_back_24"
            app:tint="@color/statistics_text_primary" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:layout_weight="1"
            android:text="@string/transaction_scan_confirmation_title"
            android:textColor="@color/statistics_text_primary"
            android:textSize="20sp"
            android:textStyle="bold" />
    </LinearLayout>

    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="20dp"
        app:cardBackgroundColor="@color/transaction_panel"
        app:cardCornerRadius="24dp"
        app:cardElevation="0dp"
        app:strokeColor="@color/transaction_border"
        app:strokeWidth="1dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="18dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tv_confirmation_summary_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/transaction_scan_confirmation_summary_title"
                    android:textColor="@color/statistics_text_primary"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tv_confirmation_summary_subtitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="@string/transaction_scan_confirmation_summary_subtitle"
                    android:textColor="@color/transaction_muted_text"
                    android:textSize="14sp" />

                <LinearLayout
                    android:id="@+id/layout_confirmation_summary_warning"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:visibility="gone">

                    <ImageView
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:src="@drawable/outline_warning_amber_24"
                        app:tint="@color/budget_warning_orange" />

                    <TextView
                        android:id="@+id/tv_confirmation_summary_warning"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:textColor="@color/budget_warning_orange"
                        android:textSize="13sp"
                        tools:text="Cần kiểm tra kỹ vì OCR còn thiếu trường quan trọng." />
                </LinearLayout>
            </LinearLayout>

            <ImageView
                android:id="@+id/iv_receipt_thumbnail"
                android:layout_width="88dp"
                android:layout_height="88dp"
                android:background="@drawable/bg_statistics_header_icon_button"
                android:contentDescription="@string/transaction_scan_confirmation_receipt_preview"
                android:padding="6dp"
                android:scaleType="centerCrop"
                android:src="@drawable/outline_receipt_24"
                app:tint="@color/transaction_income_accent" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:paddingTop="12dp">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rv_receipt_transactions"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingBottom="24dp"
            tools:listitem="@layout/item_receipt_transaction" />

        <LinearLayout
            android:id="@+id/layout_confirmation_empty"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingHorizontal="32dp"
            android:visibility="gone">

            <ImageView
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:src="@drawable/outline_receipt_24"
                app:tint="@color/transaction_muted_icon" />

            <TextView
                android:id="@+id/tv_confirmation_empty"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:gravity="center"
                android:text="@string/transaction_scan_confirmation_empty"
                android:textColor="@color/transaction_muted_text"
                android:textSize="15sp" />
        </LinearLayout>
    </FrameLayout>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_save_all_receipt_transactions"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="20dp"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="20dp"
        android:text="@string/transaction_scan_confirmation_save_all"
        android:textAllCaps="false"
        android:textColor="@color/white"
        android:textStyle="bold"
        app:backgroundTint="@color/transaction_income_accent"
        app:cornerRadius="18dp" />

</LinearLayout>
