<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center_horizontal"
    android:background="@color/statistics_surface"
    android:fitsSystemWindows="true">

    <!-- ── Header toolbar placeholder ────────────────────────────────────── -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/budget_card_stroke"
        android:layout_marginBottom="0dp" />

    <!-- Top spacer -->
    <Space android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="2" />

    <!-- ── App icon / safe icon ───────────────────────────────────────────── -->
    <FrameLayout
        android:layout_width="80dp"
        android:layout_height="80dp"
        android:background="@drawable/bg_passcode_icon_circle">

        <ImageView
            android:id="@+id/iv_lock_icon"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_gravity="center"
            android:src="@drawable/ic_shield_lock"
            android:contentDescription="@null"
            app:tint="@color/green_500"
            tools:ignore="ContentDescription" />
    </FrameLayout>

    <!-- ── Title ─────────────────────────────────────────────────────────── -->
    <TextView
        android:id="@+id/tv_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:textColor="@color/budget_text_primary"
        android:textSize="22sp"
        android:textStyle="bold"
        android:fontFamily="sans-serif-medium"
        android:letterSpacing="0.01"
        tools:text="Nhập mã PIN" />

    <!-- ── Subtitle / Error message ──────────────────────────────────────── -->
    <TextView
        android:id="@+id/tv_subtitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:textColor="@color/statistics_text_secondary"
        android:textSize="14sp"
        android:gravity="center"
        android:paddingStart="32dp"
        android:paddingEnd="32dp"
        tools:text="Nhập 6 chữ số để bảo vệ tài khoản" />

    <!-- ── 6 dot indicators ───────────────────────────────────────────────── -->
    <LinearLayout
        android:id="@+id/ll_dots"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="36dp"
        android:orientation="horizontal"
        android:gravity="center">

        <ImageView android:id="@+id/dot_1" android:layout_width="16dp" android:layout_height="16dp"
            android:layout_margin="10dp" android:background="@drawable/passcode_dot_selector"
            android:contentDescription="@null" tools:ignore="ContentDescription" />
        <ImageView android:id="@+id/dot_2" android:layout_width="16dp" android:layout_height="16dp"
            android:layout_margin="10dp" android:background="@drawable/passcode_dot_selector"
            android:contentDescription="@null" tools:ignore="ContentDescription" />
        <ImageView android:id="@+id/dot_3" android:layout_width="16dp" android:layout_height="16dp"
            android:layout_margin="10dp" android:background="@drawable/passcode_dot_selector"
            android:contentDescription="@null" tools:ignore="ContentDescription" />
        <ImageView android:id="@+id/dot_4" android:layout_width="16dp" android:layout_height="16dp"
            android:layout_margin="10dp" android:background="@drawable/passcode_dot_selector"
            android:contentDescription="@null" tools:ignore="ContentDescription" />
        <ImageView android:id="@+id/dot_5" android:layout_width="16dp" android:layout_height="16dp"
            android:layout_margin="10dp" android:background="@drawable/passcode_dot_selector"
            android:contentDescription="@null" tools:ignore="ContentDescription" />
        <ImageView android:id="@+id/dot_6" android:layout_width="16dp" android:layout_height="16dp"
            android:layout_margin="10dp" android:background="@drawable/passcode_dot_selector"
            android:contentDescription="@null" tools:ignore="ContentDescription" />
    </LinearLayout>

    <!-- ── Lockout / error message ───────────────────────────────────────── -->
    <TextView
        android:id="@+id/tv_lockout"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:textColor="@color/expense_red"
        android:textSize="13sp"
        android:gravity="center"
        android:paddingStart="32dp"
        android:paddingEnd="32dp"
        android:visibility="gone"
        tools:text="Vui lòng thử lại sau 30 giây" />

    <!-- Middle spacer -->
    <Space android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" />

    <!-- ── Divider ────────────────────────────────────────────────────────── -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/budget_card_stroke"
        android:layout_marginBottom="8dp" />

    <!-- ── Custom Numpad (GridLayout 4×3) ───────────────────────────────── -->
    <GridLayout
        android:id="@+id/gl_numpad"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="8dp"
        android:layout_marginBottom="24dp"
        android:columnCount="3"
        android:rowCount="4"
        android:useDefaultMargins="false">

        <!-- Row 1 -->
        <TextView android:id="@+id/key_1" style="@style/PasscodeKey" android:text="1"
            android:layout_column="0" android:layout_row="0" android:layout_columnWeight="1" />
        <TextView android:id="@+id/key_2" style="@style/PasscodeKey" android:text="2"
            android:layout_column="1" android:layout_row="0" android:layout_columnWeight="1" />
        <TextView android:id="@+id/key_3" style="@style/PasscodeKey" android:text="3"
            android:layout_column="2" android:layout_row="0" android:layout_columnWeight="1" />
        <!-- Row 2 -->
        <TextView android:id="@+id/key_4" style="@style/PasscodeKey" android:text="4"
            android:layout_column="0" android:layout_row="1" android:layout_columnWeight="1" />
        <TextView android:id="@+id/key_5" style="@style/PasscodeKey" android:text="5"
            android:layout_column="1" android:layout_row="1" android:layout_columnWeight="1" />
        <TextView android:id="@+id/key_6" style="@style/PasscodeKey" android:text="6"
            android:layout_column="2" android:layout_row="1" android:layout_columnWeight="1" />
        <!-- Row 3 -->
        <TextView android:id="@+id/key_7" style="@style/PasscodeKey" android:text="7"
            android:layout_column="0" android:layout_row="2" android:layout_columnWeight="1" />
        <TextView android:id="@+id/key_8" style="@style/PasscodeKey" android:text="8"
            android:layout_column="1" android:layout_row="2" android:layout_columnWeight="1" />
        <TextView android:id="@+id/key_9" style="@style/PasscodeKey" android:text="9"
            android:layout_column="2" android:layout_row="2" android:layout_columnWeight="1" />
        <!-- Row 4: Quên mã | 0 | ⌫ -->
        <TextView android:id="@+id/key_forgot" style="@style/PasscodeKey.Muted"
            android:text="Quên\nmã" android:textSize="11sp"
            android:layout_column="0" android:layout_row="3" android:layout_columnWeight="1" />
        <TextView android:id="@+id/key_0" style="@style/PasscodeKey" android:text="0"
            android:layout_column="1" android:layout_row="3" android:layout_columnWeight="1" />
        <TextView android:id="@+id/key_backspace" style="@style/PasscodeKey.Muted"
            android:text="⌫" android:textSize="22sp"
            android:layout_column="2" android:layout_row="3" android:layout_columnWeight="1" />

    </GridLayout>

</LinearLayout>
